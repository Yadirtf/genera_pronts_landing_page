# Copia este archivo a .env (cp .env.example .env) y pega la API key de al menos un proveedor.
# Las URLs y los modelos ya traen valores por defecto; cámbialos solo si quieres otro modelo.
# .env está en .gitignore: las claves nunca salen de tu equipo ni llegan al navegador.

# Proveedor que se usa si hay varias claves: anthropic | openai | gemini | openrouter | mistral
# Si lo dejas vacío o su clave falta, se usa el primero que tenga clave.
DEFAULT_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (https://platform.openai.com/api-keys)
# También sirve para modelos locales sin clave:
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1
#   LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-pro

# OpenRouter (https://openrouter.ai/keys)
# openrouter/auto elige el modelo; o pon uno concreto, p. ej. anthropic/claude-opus-4.1 o google/gemini-2.5-pro
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

PORT=8787
