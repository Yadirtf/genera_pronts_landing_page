# Copia este archivo a .env y rellena al menos un proveedor.
# .env está en .gitignore: las claves nunca salen de tu equipo ni llegan al navegador.

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Compatible con API OpenAI (OpenAI, OpenRouter, Ollama, LM Studio…)
# Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1  (sin clave)
# LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1   (sin clave)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Proveedor por defecto si hay varios: anthropic | openai
DEFAULT_PROVIDER=

PORT=8787
