{
  "name": "lienzo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n server,web -c blue,green \"npm:server\" \"npm:web\"",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "web": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hono/node-server": "^2.1.3",
    "codemirror": "^6.0.2",
    "hono": "^4.13.11",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.1"
  }
}
